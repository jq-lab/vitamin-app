# Copy this file to `.env.tts-bakeoff` and fill real provider credentials.
# Do not commit `.env.tts-bakeoff`.

# Cinematic / reference-quality route. Requires a legal voice ID.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_NOIR_VOICE_ID=
